# Dedicated project/port: do not reuse another application's project or volumes.
STACK_NAME=headsup-demo
ORIGIN_PORT=8081
# Origins only, without trailing slashes; this API is exposed at hostname root.
API_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
DB_USER=headsup
DB_NAME=headsup
DB_PASSWORD=REPLACE_WITH_GENERATED_SECRET
SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
ADMIN_PAGES_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
REFERRAL_CODE_ENABLED=true
REFERRAL_CODE=REPLACE_WITH_PRIVATE_INVITE_CODE
RATE_LIMIT_ENABLED=true
# Optional initially; the admin queue stays off until explicitly enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_ALERT_MODEL=gpt-5.4-nano
# Supply this deployment's existing real SMTP settings. No Mailpit overrides.
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_FROM=updates@example.com
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_USE_CREDENTIALS=true
MAIL_VALIDATE_CERTS=true
